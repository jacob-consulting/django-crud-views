import ast
import hashlib
import json
import pathlib
import re
import subprocess

root = pathlib.Path.cwd()
phase = root / ".planning/phases/06.50-move-remaining-link-consumers-to-the-shared-link-check-stage"
baseline_text = (phase / "06.50-COST-BASELINE.md").read_text()
before = baseline_text.split("\n## After measurements", 1)[0]
assert len(before.encode()) == 32282
assert hashlib.sha256(before.encode()).hexdigest() == "4e9436029aff6629e0a9c38d703beb50015b39d664e6486cb925a2fe09ab7c55"
receipt = json.loads(re.search(r"```json\n(.*?)\n```", before, re.S)[1])
for name, entry in receipt["artifacts"].items():
    data = subprocess.check_output(["git", "cat-file", "blob", entry["git_blob"]])
    assert len(data) == entry["bytes"], name
    assert hashlib.sha256(data).hexdigest() == entry["sha256"], name
different = {
    path: hashlib.sha256((root / path).read_bytes()).hexdigest()
    for path, expected in receipt["source_sha256"].items()
    if hashlib.sha256((root / path).read_bytes()).hexdigest() != expected
}
assert set(different) == {
    "tests/test1/link_access_matrix_baseline.json",
    "tests/test1/test_ancestor_costs.py",
    "src/crud_views_guardian/lib/views.py",
}, different
goldens = [p for p in receipt["source_sha256"] if "/golden/" in p]
assert len(goldens) == 34 and not set(goldens) & different.keys()
for path, digest in json.loads(pathlib.Path("/tmp/cv-0650-original/hashes.json").read_text()).items():
    assert hashlib.sha256((root / path).read_bytes()).hexdigest() == digest, path

calls = []
definitions = []
removed = []
class Scan(ast.NodeVisitor):
    def __init__(self, path):
        self.path = path
        self.scope = []

    def visit_ClassDef(self, node):
        self.scope.append(node.name)
        self.generic_visit(node)
        self.scope.pop()

    def visit_FunctionDef(self, node):
        definitions.append((self.path, node.lineno, ".".join([*self.scope, node.name])))
        self.scope.append(node.name)
        self.generic_visit(node)
        self.scope.pop()

    def visit_Call(self, node):
        if isinstance(node.func, ast.Attribute) and node.func.attr in {
            "cv_has_access", "cv_action_enabled", "_cv_action_enabled_for_rendering",
            "_cv_action_enabled_for_context", "_link_access", "_link_permission",
        }:
            calls.append({"file": self.path, "line": node.lineno, "caller": ".".join(self.scope), "method": node.func.attr})
        self.generic_visit(node)

    def generic_visit(self, node):
        if any(getattr(node, attr, None) == "_page_action_object" for attr in ("id", "attr", "name")):
            removed.append((self.path, node.lineno))
        super().generic_visit(node)

for path in subprocess.check_output(["git", "ls-files", "src", "tests"], text=True).splitlines():
    if path.endswith(".py"):
        Scan(path).visit(ast.parse((root / path).read_text()))
assert not removed, removed
public_calls = [c for c in calls if c["file"].startswith("src/") and c["method"] in {"cv_has_access", "cv_action_enabled"}]
assert len(public_calls) == 13, public_calls
adapters = [c for c in calls if c["file"].startswith("src/") and c["method"] == "_cv_action_enabled_for_rendering"]
assert len(adapters) == 1 and adapters[0]["caller"] == "GuardianParentPermissionMixin._cv_cancel_target_available", adapters
for owner in ("CrudView", "CreateView"):
    for method in ("_cv_action_enabled_for_context", "_cv_action_enabled_for_rendering"):
        assert any(n == owner + "." + method for _, _, n in definitions)
migrated_files = {
    "src/crud_views/lib/view/buttons.py", "src/crud_views/lib/views/card.py", "src/crud_views/lib/navbar.py",
    "src/crud_views/templatetags/crud_views.py", "src/crud_views/lib/bulk/__init__.py",
}
assert not [c for c in public_calls if c["file"] in migrated_files]
assert not [c for c in calls if c["caller"] in {"CrudView._cv_get_action_context", "_cancel_target_available"} and c["method"] in {"cv_has_access", "cv_action_enabled", "_cv_action_enabled_for_rendering"}]

base = "ba1465c8d9361ca08d6d97c9a4ddb47fa83082c9"
path = "src/crud_views/lib/view/base.py"
old = ast.parse(subprocess.check_output(["git", "show", base + ":" + path], text=True))
new = ast.parse((root / path).read_text())
for cls_name, method in (("CrudView", "dispatch"), ("CrudViewPermissionRequiredMixin", "has_permission")):
    def get(tree):
        cls = next(n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == cls_name)
        return next(n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name == method)
    assert ast.dump(get(old), include_attributes=False) == ast.dump(get(new), include_attributes=False), (cls_name, method)

print(json.dumps({
    "product_head": subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip(),
    "result": "passed", "before_bytes": len(before.encode()), "before_artifacts": len(receipt["artifacts"]),
    "goldens_unchanged": len(goldens), "protected_hashes": len(receipt["source_sha256"]),
    "permitted_hash_differences": different, "public_calls": public_calls, "rendering_adapter_calls": adapters,
    "removed_helper_references": removed,
    "base_request_nodes_unchanged": ["CrudView.dispatch", "CrudViewPermissionRequiredMixin.has_permission"],
    "source_tree": subprocess.check_output(["git", "rev-parse", "HEAD:src"], text=True).strip(),
}, indent=2))
