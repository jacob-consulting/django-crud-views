te\"):\n                own.assert_not_called()\n            else:\n                own.assert_called_once_with(actor, page.object)\n                assert own.call_args.args[1] is page.object\n            expected = [\n                (ancestor.name, obj)\n                for (_, ancestor), obj in reversed(list(zip(ancestors._walk_ancestors(family.vs), known, strict=True)))\n                if obj is not None\n            ]\n            if outcome == \"higher\" and family_name == \"note\":\n                expected = expected[:1]\n&gt;           assert events == expected\nE           AssertionError: assert [] == [('consumerpu...r publisher&gt;)]\nE             \nE             Right contains one more item: ('consumerpub1b904815', &lt;Publisher: Consumer publisher&gt;)\nE             Use -v to get more diff\n\ntests/test1/test_link_consumers.py:71: AssertionError</failure></testcase><testcase classname=\"tests.test1.test_link_consumers\" name=\"test_permission_filter_checks_known_ancestry_without_state[missing-note]\" time=\"0.318\"><failure message=\"AssertionError: assert True is False&#10; +  where True = cv_context_has_permission(&lt;crud_views.lib.view.meta.ConsumernoteDetail object at 0x7873082b36b0&gt;, 'update')\">family_name = 'note', outcome = 'missing'\nmonkeypatch = &lt;_pytest.monkeypatch.MonkeyPatch object at 0x787309423aa0&gt;\n\n    @pytest.mark.django_db\n    @pytest.mark.parametrize(\"family_name\", [\"book\", \"note\"])\n    @pytest.mark.parametrize(\"outcome\", [\"allowed\", \"nearest\", \"higher\", \"own\", \"missing\", \"hole\"])\n    def test_permission_filter_checks_known_ancestry_without_state(family_name, outcome, monkeypatch):\n        with isolated_routes(consumer_routes) as ns:\n            world = consumer_world()\n            actor = consumer_actor(ns, world)\n            family = getattr(ns, family_name)\n            page = consumer_view(family, \"Detail\", actor, world, guarded=outcome != \"missing\")\n            target = family.Upda